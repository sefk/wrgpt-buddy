# Copy to .env (bin/deploy and bin/install-launchd create it and a SECRET_KEY if missing).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0                       # 1 for local development only
DJANGO_ALLOWED_HOSTS=                # default: * (gunicorn listens on all interfaces)
DJANGO_CSRF_TRUSTED_ORIGINS=         # default: https://<tailnet host>[:port]
DJANGO_SECURE_COOKIES=0              # 1 = https-only cookies (breaks POSTs over plain http://host:8017)
DJANGO_LOG_LEVEL=INFO
WRGPT_TAILNET_HOST=studio.tailc33641.ts.net
WRGPT_TAILNET_PORT=10000
WRGPT_PLAYER_NAME=sefk
WRGPT_PLAYER_EMAIL=sefklon@gmail.com
GMAIL_QUERY="label:wrgpt after:2026/09/01"
OPENROUTER_API_KEY=                  # optional: adds Qwen Flash via OpenRouter (~$0.003 per decision)
# Used by bin/ scripts and launchd only:
GUNICORN_BIND=0.0.0.0:8017
GUNICORN_WORKERS=2
