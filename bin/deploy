#!/usr/bin/env bash
# Apply code changes: sync deps, migrate, collectstatic, restart web.
set -euo pipefail
. "$(dirname "$0")/_common.sh"
cd "$ROOT"
ensure_env
"$UV" sync
"$UV" run manage.py migrate --noinput
"$UV" run manage.py collectstatic --noinput
if launchctl print "$GUI/$WEB_LABEL" >/dev/null 2>&1; then
  launchctl kickstart -k "$GUI/$WEB_LABEL"
  echo "web restarted"
else
  echo "web agent not loaded; run bin/install-launchd"
fi
