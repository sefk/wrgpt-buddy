#!/usr/bin/env bash
# Apply code changes: sync deps, migrate, collectstatic, restart web and the recommend worker.
set -euo pipefail
. "$(dirname "$0")/_common.sh"
cd "$ROOT"
ensure_env
"$UV" sync
"$UV" run manage.py migrate --noinput
"$UV" run manage.py collectstatic --noinput
for label in "$WEB_LABEL" "$RECOMMEND_LABEL"; do
  if launchctl print "$GUI/$label" >/dev/null 2>&1; then
    launchctl kickstart -k "$GUI/$label"
    echo "$label restarted"
  else
    echo "$label not loaded; run bin/install-launchd"
  fi
done
