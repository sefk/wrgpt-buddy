#!/usr/bin/env bash
# Summarize launchd jobs, recent logs, and the last poll result.
set -uo pipefail
. "$(dirname "$0")/_common.sh"
for label in "$WEB_LABEL" "$POLL_LABEL" "$RECOMMEND_LABEL"; do
  echo "== $label"
  if out="$(launchctl print "$GUI/$label" 2>&1)"; then
    echo "$out" | grep -E '^\s*(state|pid|runs|last exit code|run interval|program) ' || true
  else
    echo "not loaded"
  fi
done
for f in web.err web.out poll.out poll.err recommend.out recommend.err; do
  echo; echo "== $f.log (last 8)"
  tail -n 8 "$LOG_DIR/$f.log" 2>/dev/null || echo "(no log)"
done
echo
echo "== last poll"
poll_status() {
  local last_exit; last_exit="$(launchctl print "$GUI/$POLL_LABEL" 2>/dev/null | awk -F'= ' '/last exit code/{print $2; exit}')"
  [ -n "$last_exit" ] && echo "last exit code: $last_exit"
  if [ -n "$last_exit" ] && [ "$last_exit" != "0" ]; then echo "POLL FAILING (see poll.err.log)"; fi
  # bin/poll tees failures to stdout too, so poll.out.log alone is in order
  grep -E 'POLL (OK|FAILED)' "$LOG_DIR/poll.out.log" 2>/dev/null | tail -n 1
}
poll_status
