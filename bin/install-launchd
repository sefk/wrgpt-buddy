#!/usr/bin/env bash
# Render deploy/launchd/*.plist.in into ~/Library/LaunchAgents and (re)load them.
set -euo pipefail
. "$(dirname "$0")/_common.sh"
cd "$ROOT"
ensure_env
mkdir -p "$LOG_DIR" "$AGENTS_DIR"
for label in "$WEB_LABEL" "$POLL_LABEL" "$RECOMMEND_LABEL"; do
  tpl="$ROOT/deploy/launchd/$label.plist.in"
  dest="${PLIST_DEST:-$AGENTS_DIR}/$label.plist"
  sed -e "s|@ROOT@|$ROOT|g" -e "s|@UV@|$UV|g" -e "s|@HOME@|$HOME|g" -e "s|@LOG_DIR@|$LOG_DIR|g" "$tpl" > "$dest"
  plutil -lint "$dest" >/dev/null
  [ -n "${PLIST_DEST:-}" ] && { echo "rendered $dest"; continue; }
  launchctl bootout "$GUI/$label" 2>/dev/null || true
  # bootout is asynchronous; bootstrap fails with "5: Input/output error" until it finishes.
  for attempt in 1 2 3 4 5; do
    launchctl bootstrap "$GUI" "$dest" 2>/dev/null && break
    [ "$attempt" = 5 ] && { echo "bootstrap failed for $label" >&2; exit 1; }
    sleep 1
  done
  echo "loaded $label"
done
